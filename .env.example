# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Load before starting Claude Code:
#   set -a; source .env; set +a; claude
#
# ASTA_API_KEY — Ai2 Asta Scientific Corpus Tool, used by the cross-field
# methodology search. Request one (free) at:
#   https://share.hsforms.com/1L4hUh20oT3mu8iXJQMV77w3ioxm
#
# Optional. Without it the arXiv and PubMed legs run normally and the
# cross-field pass is skipped with a notice. Do NOT run that pass unauthenticated:
# Asta's search tools do not return a clean auth error, they hang ~271s and then
# fail with a misleading ConnectionRefusedError.
ASTA_API_KEY=
#
# SEMANTIC_SCHOLAR_API_KEY — optional, speed only. scripts/link_papers.py fetches
# every paper's references and SPECTER2 embedding in one Semantic Scholar batch
# request. Without a key it shares a public quota that rejects most requests at
# busy times; the script retries for up to 10 minutes and then skips linking.
# Free key: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
